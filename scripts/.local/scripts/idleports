#!/bin/sh

# idleports - Show available ports in range 3000-3099 (listening ones dimmed)

if ! command -v ss > /dev/null 2>&1; then
    echo "[ERROR] ss is not installed (iproute2)." >&2
    exit 1
fi

used=" $(ss -tln | grep -o ':30[0-9]*' | tr -d ':' | sort -u | tr '\n' ' ')"

for port in $(seq 3000 3099); do
    case "$used" in
        *" $port "*) printf '\033[38;5;235m%s\033[0m  ' "$port" ;;
        *)           printf '%s  ' "$port" ;;
    esac
    [ $((port % 10)) -eq 9 ] && printf '\n'
done
